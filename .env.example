# Google AI Studio key — https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=

# Corpus: folder holding the source PDFs, one sub-folder per area
RAG_CORPUS_DIR=corpus
# Official exams used to build the labelled evaluation set
RAG_EXAMS_DIR=exams

# Models
# gemini-embedding-2 is current. gemini-embedding-001 also works (deprecated, shutdown
# 2028-05-14). text-embedding-004 was shut down on 2026-01-14 and no longer works.
# https://ai.google.dev/gemini-api/docs/deprecations
RAG_EMBED_MODEL=gemini-embedding-2
# Size of the stored vectors. Google recommends 768, 1536 or 3072; 768 keeps a pgvector
# HNSW index under that extension's 2,000-dimension limit.
RAG_EMBED_DIM=768
RAG_CHAT_MODEL=gemini-2.5-flash

# Vector store: "local" (numpy, exact cosine) or "pgvector"
RAG_STORE=local

# pgvector — a dedicated free Supabase project, NOT a production database.
# Supabase dashboard > Project Settings > Database > Connection string (Session pooler).
RAG_PG_DSN=
